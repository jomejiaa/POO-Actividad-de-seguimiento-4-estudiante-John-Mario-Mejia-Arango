package com.mycompany.ejerciciopag418;

public class EquipoMaratonProgramacion {

    private String nombreEquipo;
    private String universidad;
    private String lenguajeProgramacion;

    private int tamanoEquipo;

    private Programador[] programadores;


    public EquipoMaratonProgramacion(String nombreEquipo,
                                     String universidad,
                                     String lenguajeProgramacion) {

        validarCampo("Nombre del equipo", nombreEquipo);
        validarCampo("Universidad", universidad);
        validarCampo("Lenguaje de programacion", lenguajeProgramacion);

        this.nombreEquipo = nombreEquipo;
        this.universidad = universidad;
        this.lenguajeProgramacion = lenguajeProgramacion;

        this.tamanoEquipo = 0;
        this.programadores = new Programador[3];
    }

    public static void validarCampo(String campo, String valor) {

        if (valor == null || valor.trim().isEmpty()) {
            throw new IllegalArgumentException(
                "El campo " + campo + " no puede estar vacio."
            );
        }

        if (campo.equalsIgnoreCase("nombre")
                || campo.equalsIgnoreCase("apellido")) {

            // Validar longitud inferior a 20 caracteres
            if (valor.trim().length() >= 20) {
                throw new IllegalArgumentException(
                    "El campo " + campo + " debe tener menos de 20 caracteres."
                );
            }

            if (!valor.trim().matches("[\\p{L} ]+")) {
                throw new IllegalArgumentException(
                    "El campo " + campo + " solamente admite letras."
                );
            }
        }
    }

    public boolean estaLleno() {
        return tamanoEquipo == 3;
    }

    public void anadir(Programador programador) {

        if (estaLleno()) {
            throw new IllegalStateException(
                "El equipo ya tiene el maximo de 3 programadores."
            );
        }

        if (programador == null) {
            throw new IllegalArgumentException(
                "El programador no puede ser nulo."
            );
        }

        validarCampo("Nombre", programador.getNombre());
        validarCampo("Apellido", programador.getApellido());

        programadores[tamanoEquipo] = programador;

        tamanoEquipo++;
    }

    public boolean estaCompleto() {
        return tamanoEquipo >= 2;
    }

    public String getNombreEquipo() {
        return nombreEquipo;
    }

    public String getUniversidad() {
        return universidad;
    }

    public String getLenguajeProgramacion() {
        return lenguajeProgramacion;
    }

    public int getTamanoEquipo() {
        return tamanoEquipo;
    }

    public Programador[] getProgramadores() {
        return programadores.clone();
    }
}

