    private void btnCrearEquipoActionPerformed(java.awt.event.ActionEvent evt) {                                               

    try {

        String nombre = txtNombreEquipo.getText();
        String universidad = txtUniversidad.getText();
        String lenguaje = txtLenguaje.getText();

        equipo = new EquipoMaratonProgramacion(
            nombre,
            universidad,
            lenguaje
        );

        JOptionPane.showMessageDialog(
            this,
            "Equipo creado correctamente."
        );

        lblEstado.setText("Equipo creado. Integrantes: 0");

        txtNombreEquipo.setText("");
        txtUniversidad.setText("");
        txtLenguaje.setText("");

    } catch (IllegalArgumentException e) {

        JOptionPane.showMessageDialog(
            this,
            e.getMessage(),
            "Error de validacion",
            JOptionPane.ERROR_MESSAGE
        );
    }

    }                                              

    private void btnAnadirProgramadorActionPerformed(java.awt.event.ActionEvent evt) {                                                     

    try {

        if (equipo == null) {
            throw new IllegalStateException(
                "Primero debe crear un equipo."
            );
        }

        String nombre = txtNombre.getText();
        String apellido = txtApellido.getText();

        Programador programador = new Programador(
            nombre,
            apellido,
            equipo.getUniversidad()
        );

        equipo.anadir(programador);

        txtIntegrantes.append(
            equipo.getTamanoEquipo() + ". "
            + programador.getNombre() + " "
            + programador.getApellido() + "\n"
        );

        if (equipo.estaLleno()) {

            lblEstado.setText("Equipo lleno: 3 de 3 integrantes.");

        } else if (equipo.estaCompleto()) {

            lblEstado.setText("Equipo completo: "
                + equipo.getTamanoEquipo() + " de 3 integrantes.");

        } else {

            lblEstado.setText("Equipo incompleto: "
                + equipo.getTamanoEquipo() + " de 3 integrantes.");
        }

        txtNombre.setText("");
        txtApellido.setText("");

        JOptionPane.showMessageDialog(
            this,
            "Programador agregado correctamente."
        );

    } catch (IllegalArgumentException | IllegalStateException e) {

        JOptionPane.showMessageDialog(
            this,
            e.getMessage(),
            "Error al agregar programador",
            JOptionPane.ERROR_MESSAGE
        );
    }

    }                                                    

    private void btnLimpiarActionPerformed(java.awt.event.ActionEvent evt) {                                           

    txtNombreEquipo.setText("");
    txtUniversidad.setText("");
    txtLenguaje.setText("");

    txtNombre.setText("");
    txtApellido.setText("");

    txtNombreEquipo.requestFocus();

    }                                          

