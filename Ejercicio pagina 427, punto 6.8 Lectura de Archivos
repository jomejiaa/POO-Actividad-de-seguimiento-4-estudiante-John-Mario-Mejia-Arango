    private void btnExaminarActionPerformed(java.awt.event.ActionEvent evt) {                                            
    javax.swing.JFileChooser selector = new javax.swing.JFileChooser();

    selector.setDialogTitle("Seleccionar archivo de texto");

    javax.swing.filechooser.FileNameExtensionFilter filtro =
            new javax.swing.filechooser.FileNameExtensionFilter(
                    "Archivos de texto (*.txt)", "txt");

    selector.setFileFilter(filtro);

    int resultado = selector.showOpenDialog(this);

    if (resultado == javax.swing.JFileChooser.APPROVE_OPTION) {

        java.io.File archivoSeleccionado = selector.getSelectedFile();

        txtRutaArchivo.setText(archivoSeleccionado.getAbsolutePath());

    }
    }                                           

    private void btnLeerActionPerformed(java.awt.event.ActionEvent evt) {                                        
    String ruta = txtRutaArchivo.getText();

    if (ruta.isEmpty()) {

        javax.swing.JOptionPane.showMessageDialog(
                this,
                "Primero debe seleccionar un archivo de texto.",
                "Advertencia",
                javax.swing.JOptionPane.WARNING_MESSAGE
        );

    } else {

        LeerArchivo lector = new LeerArchivo();

        String contenido = lector.leerArchivo(ruta);

        txtContenido.setText(contenido);

    }
    }                                       

    private void btnLimpiarActionPerformed(java.awt.event.ActionEvent evt) {                                           
    txtRutaArchivo.setText("");

    txtContenido.setText("");

    txtRutaArchivo.requestFocusInWindow();
    }                                          

    private void btnSalirActionPerformed(java.awt.event.ActionEvent evt) {                                         
    int respuesta = javax.swing.JOptionPane.showConfirmDialog(
